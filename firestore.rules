// Firestore Rules – Quelle der Wahrheit für dieses Projekt.
// Deploy: firebase deploy --only firestore:rules --project wishlist-676f9
//
// Grundsätze:
//  - Nutzerdaten und Wünsche gehören dem Besitzer (isOwner).
//  - Fremde sehen von einer geteilten Liste nur Wünsche mit public == true
//    und dürfen daran ausschließlich completed/completedAt setzen (mit Login).
//  - /users ist nicht auflistbar (sonst wären alle E-Mail-Adressen lesbar).
//  - Share-Codes sind per bekanntem Code lesbar, aber nicht enumerierbar.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Fremder darf an einem öffentlichen Wunsch ausschließlich den
    // Erledigt-Status setzen.
    function isCompleteToggle() {
      return resource.data.public == true
          && request.resource.data.public == true
          && request.resource.data.diff(resource.data)
               .changedKeys().hasOnly(['completed', 'completedAt']);
    }

    match /users/{userId} {
      allow get, write: if isOwner(userId);

      match /wishes/{wishId} {
        // Besitzer: Vollzugriff
        allow read, write: if isOwner(userId);

        // Fremde: nur öffentliche Wünsche lesen. Für list() erzwingt Firestore
        // dadurch eine .where('public', isEqualTo: true)-Query.
        allow read: if resource.data.public == true;

        // Fremde: öffentlichen Wunsch abhaken (nur completed/completedAt)
        allow update: if isAuthenticated() && isCompleteToggle();
      }

      match /sharedCode/{codeId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /shareCodes/{codeId} {
      allow get: if true;      // Lookup per bekanntem Code (auch ohne Login)
      allow list: if false;    // keine Enumeration aller Codes
      allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated()
          && resource.data.userId == request.auth.uid;
    }

    match /feedback/{feedbackId} {
      allow get, list: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
          && request.resource.data.diff(resource.data)
               .changedKeys().hasOnly(['likes']);
      allow delete: if false;
    }
  }
}
